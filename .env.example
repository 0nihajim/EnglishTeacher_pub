# リポジトリ直下に .env としてコピーする。読むのはサーバーだけで、ブラウザには渡らない。

# Gemini API キー — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── ここから下は任意(既定値を記載) ───────────────────────────────────────────
# 先生の人格は server/prompts/{instructions,greeting}.md にある。
# 中身を書き換えてサーバーを再起動すれば反映される。
#
# GEMINI_LIVE_MODEL=gemini-3.8-live   # 背景推論が要るなら gemini-3.8-live-extended-thinking
# GEMINI_VOICE=Kore                   # Kore Puck Charon Fenrir Aoede Leda Orus Zephyr ...
# GEMINI_DEBUG=1                      # 受信イベントを全部ログに出す(音声は伏せる)。うるさい
# GEMINI_VAD_SILENCE_MS=1500          # 学習者がこれだけ黙ると「言い終えた」。短いと文中の息継ぎで先生が答え始める
#                                     # (発話の区切りを「自動」にしたときだけ効く。「手動」は送信ボタンで区切る)
# GEMINI_VAD_START_SENSITIVITY=LOW    # LOW=雑音・エコーで割り込みにくい / HIGH=小声でも発話が開く
# GEMINI_INPUT_LANGUAGES=en-US,ja-JP  # 学習者が話す言語(BCP-47、カンマ区切り)。文字起こしのヒントと先生への指示になる。
#                                     # 英語が別の言語として拾われるのを減らす。空にすると自動判定
# GEMINI_FLASH_MODEL=gemini-3.8-flash # 話し直しで説明の整理と振り返りに使う通常のマルチモーダルモデル(構造化出力)
# GEMINI_IMAGE_VIA=realtime           # 話し直しで画像を Live に渡す経路。realtime=sendRealtimeInput の video(公式の経路)
#                                     # / content=挨拶と同じ clientContent の inlineData。先生が「画像が見えない」と言うなら切り替える
# PORT=8787
